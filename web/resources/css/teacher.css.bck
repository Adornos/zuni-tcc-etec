.teacher-sidebar {
    /* width: 260px; */
    grid-area: Sidebar;

    background: #C13936;
    border-right: 1px solid #e5e5e5;
}

.teacher-sidebar .nav-link {
    color: #fff;
    padding: 10px;
    padding-left: 48px;
    transition: 0.2s;
}

.teacher-sidebar .nav-link:hover {
    background: #fff;
    color: #C13936;
}


.teacher-sidebar .nav-link i {
    width: 40px;
    font-size: 40px;
    text-align: center;
    color: #fff;
}

.teacher-sidebar .nav-link:hover i {
    color: #C13936;
}

.teacher-sidebar .sidebar-bottom .nav-link i {
    width: 20px;
    font-size: 20px;
    text-align: center;
}

.teacher-panel > div{
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: repeat(5, 1fr);
    background-color: #E7EFFA;

    grid-template-areas: 
    "Sidebar Header Header Header Header"
    "Sidebar Panel Panel Panel Panel"
    "Sidebar Panel Panel Panel Panel"
    "Sidebar Panel Panel Panel Panel"
    "Sidebar Panel Panel Panel Panel"; 

    height: 100vh;

}

.teacher-header{ grid-area: Header; }


.teacher-dashboard,
.teacher-schedule { grid-area: Panel; }
    

.schedule-table{
    border-collapse:separate;
    border-spacing:12px;
}

.schedule-table th{
    text-align:center;
    font-size:1.1rem;
    font-weight:600;
    color:#222;
    padding-bottom:10px;
}

.schedule-table td{
    min-width:220px;
    vertical-align:top;
}

.schedule-card{
    background:white;
    border-radius:14px;
    padding:15px;
    display:flex;
    gap:12px;
    align-items:flex-start;
    box-shadow:0 2px 8px rgba(0,0,0,0.06);
}

.schedule-line{
    width:5px;
    min-height:60px;
    border-radius:10px;
    background:#1d2dff;
}

.schedule-title{
    font-size:1.1rem;
    font-weight:700;
    margin-bottom:5px;
}

.schedule-info{
    color:#444;
    font-size:1rem;
    margin-bottom:8px;
}

.time-badge{
    background:#d74444;
    color:white;
    border-radius:30px;
    padding:4px 10px;
    font-size:.75rem;
}

.hour-label{
    font-weight:600;
    margin-right:5px;
}

.time-row{
    display:flex;
    align-items:center;
    gap:5px;
    flex-wrap:wrap;
}

.time-column{
    width:90px;
    text-align:center;
    font-weight:700;
    color:#666;
    font-size:.9rem;
}